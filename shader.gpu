// Vertex shader (Phong)
const vertexShaderSource = `
attribute vec3 a_position;
attribute vec3 a_normal;

uniform mat4 u_projectionMatrix;
uniform mat4 u_modelViewMatrix;
uniform mat4 u_normalMatrix;

varying vec3 v_normal;
varying vec3 v_viewPos;

void main() {
    vec4 viewPos4 = u_modelViewMatrix * vec4(a_position, 1.0);
    v_viewPos = viewPos4.xyz;

    // нормаль у view space
    v_normal = normalize((u_normalMatrix * vec4(a_normal, 0.0)).xyz);

    gl_Position = u_projectionMatrix * viewPos4;
}
`;

// Fragment shader (Phong)
const fragmentShaderSource = `
precision mediump float;

uniform vec3 u_lightPosition;
uniform vec4 u_wireframeColor;
uniform int u_renderMode; 

varying vec3 v_normal;
varying vec3 v_viewPos;

void main() {

    if (u_renderMode == 1) {
        gl_FragColor = vec4(u_wireframeColor.rgb, 1.0);
        return;
    }

    if (u_renderMode == 2) {
        gl_FragColor = vec4(1.0, 1.0, 0.8, 1.0);
        return;
    }

    vec3 N = normalize(v_normal);
    vec3 L = normalize(u_lightPosition - v_viewPos);
    vec3 V = normalize(-v_viewPos);
    vec3 R = reflect(-L, N);

    vec3 ambientColor = vec3(0.1, 0.1, 0.2);
    vec3 lightColor   = vec3(1.0, 1.0, 1.0);
    vec3 surfaceColor = vec3(0.8, 0.5, 0.02);
    float shininess = 64.0;

    float diff = max(dot(N, L), 0.0);
    float spec = pow(max(dot(V, R), 0.0), shininess);

    vec3 ambient  = ambientColor * surfaceColor;
    vec3 diffuse  = surfaceColor * diff;
    vec3 specular = lightColor * spec;

    vec3 color = ambient + diffuse + specular;

    gl_FragColor = vec4(color, 1.0);
}
`;
